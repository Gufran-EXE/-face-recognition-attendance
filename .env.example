# Environment Configuration Example
# Copy this file to .env and fill in your values

# Application
APP_NAME=Face Recognition Attendance System
APP_ENV=development
DEBUG=True
SECRET_KEY=your-secret-key-change-in-production

# Database
DATABASE_URL=sqlite:///./attendance.db
# For PostgreSQL: postgresql://user:password@localhost:5432/attendance_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Face Recognition
CONFIDENCE_THRESHOLD=0.6
DUPLICATE_CHECK_WINDOW_MINUTES=5
FACE_ENCODING_MODEL=hog  # or cnn for GPU

# JWT
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Email (for notifications)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@attendance.system

# SMS (for alerts)
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Webcam
WEBCAM_INDEX=0
FRAME_WIDTH=640
FRAME_HEIGHT=480
FPS=30
